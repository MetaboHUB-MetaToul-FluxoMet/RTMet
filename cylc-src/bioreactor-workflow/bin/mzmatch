#! /usr/bin/env python3

import argparse
from pathlib import Path

import pandas as pd


def match_table(bih_file: Path, extracted_features_file:Path, ppm_tol:int):
    """
    This function creates an array containing only the annotated features and 
    their corresponding attributes, by merging the output files from both bank_inhouse 
    and the extracted features.

    :param bih_file: Path to the output file generated by bank_inhouse.
    :param extracted_features_file: Path to the extracted features file generated by the extract_features script.
    :param ppm_tol: Tolerance in ppm.
    """

    annotated_file = pd.read_csv(bih_file, sep="\t")
    
    extracted_features = pd.read_csv(extracted_features_file, sep="\t")
    extracted_features = extracted_features.rename(columns={"mz" : "MzQuery"})
    
    # Catch sample name from bank_inhouse file 
    sample_name = Path(bih_file).stem.split(".")[0]
    # Define output files paths
    output_file_matches = f"{sample_name}.matches.tsv"

    merged_df = pd.merge(annotated_file, extracted_features, on="MzQuery")
    merged_df = merged_df.rename(columns={f"MzDelta_Query-Bank({ppm_tol}ppm)" : "MzDelta_ppm",
                                "MzBank": "MzDatabase"})
    merged_df.insert(0, "Sample Name", sample_name)

    precursor_col = "Precursor Name"

    # Filter out rows containing a non-zero value in the "Precursor Name" column
    # copy of the dataframe is created to avoid SettingWithCopyWarning
    matches = merged_df[~merged_df[precursor_col].isna()].copy()


    # Number of occurrences for each precursor
    matches["nb_occurrences"] = (
        matches.groupby(precursor_col)[precursor_col]
        .transform("size")
    )

    # Keep the row with the smallest MzDelta_ppm for each precursor
    df_filtered = (
        matches.loc[matches.groupby(precursor_col)["MzDelta_ppm"].idxmin()]
        .reset_index(drop=True)
    )

    df_filtered["Comment"] = (
        "Selected among "
        + df_filtered["nb_occurrences"].astype(str)
        + " values"
    )

    # Remove temporary column
    df_filtered = df_filtered.drop(columns="nb_occurrences")

    # Reorder columns
    cols_to_move = [
        "Datetime",
        "Sample Name",
        "cycle",
        "intensity",
        "Precursor Name",
    ]

    final_df = df_filtered[
        cols_to_move + [c for c in df_filtered.columns if c not in cols_to_move]
    ]
    
    final_df.to_csv(f"{output_file_matches}", sep="\t", index=False)

def main():
    parser = argparse.ArgumentParser(
        description="Matches peaks from a annotated_file file on a annotated_file file."
    )
    parser.add_argument(
        "--bih_file",
        type=Path,
        help="Path to the annotated file (annotated.tsv).",
    )

    parser.add_argument(
        "--extracted_features_file",
        type=Path,
        help="Path to the profia file (features.csv).",
    )

    parser.add_argument(
            "--ppm",
            type=int,
            help="Tolerance in ppm for the m/z matching.",
        )

    args = parser.parse_args()

    match_table(args.bih_file, args.extracted_features_file, args.ppm)

if __name__ == "__main__":
    main()
