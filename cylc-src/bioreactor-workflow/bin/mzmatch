#! /usr/bin/env python3

import argparse
from pathlib import Path

import pandas as pd

# pd.set_option("display.max_columns", None)

def match_table(query_file: Path, profia_file:Path, tol_ppm, precursor_name_col):
    """
    This function constructs an array that includes only the annotated 
    features and their corresponding characteristics, based on the output 
    files from both bank_inhouse and profia.

    :param query_file: Path to the output file generated by bank_inhouse.
    :param profia_file: Path to the output file generated by profia.
    :param tol_ppm: Tolerance in ppm.
    :param precursor_name_col: Column index for the precursor name.
    """

    annotated_file = pd.read_csv(query_file, sep="\t")
    
    profia_file = pd.read_csv(profia_file, sep="\t")
    
    # Catch sample name from bank_inhouse file 
    sample_name = Path(query_file).stem.split(".")[0]
    # Define output files paths
    output_file_matches = f"{sample_name}.matches.tsv"

    annotated_file.insert(0, "Datetime", profia_file["Datetime"])
    annotated_file.insert(1, "Sample Name", sample_name)
    annotated_file.insert(3, "Intensity", profia_file["areaIntensity"])

    # precursor_name_col + 4 => +4 corresponds to the first 4 columns in the file 
    precursor_name_col = precursor_name_col + 4

    # Filters out rows containing a non-zero value in the "Precursor Name" column
    matches = annotated_file[~annotated_file.iloc[:,precursor_name_col].isna().reset_index(drop=True)].rename(
        columns={f"MzDelta_Query-Bank({tol_ppm}ppm)" : "MzDelta_ppm",
                 "MzBank": "MzDatabase"}
    )

    # For each “Precursor Name”, we retrieve the index of the line with the smallest value of “MzDelta_ppm”
    idx = matches.groupby(matches.iloc[:, precursor_name_col])['MzDelta_ppm'].idxmin()
    
    # We count how many times each “Precursor Name” appears (i.e. how many matches it has).
    nb = matches.groupby(matches.iloc[:, precursor_name_col])['MzDelta_ppm'].count().reset_index(name='count')
    
    # We select only the lines with the smallest “MzDelta_ppm” values for each precursor.
    df_filtered = matches.loc[idx].reset_index(drop=True)
    
    # We add the column “Nb” to know how many values were in competition for each selection.
    df_filtered["Nb"] = nb["count"]
    # Add a custom comment indicating how many values have been compared
    df_filtered["Comment"] = df_filtered["Nb"].apply(
        lambda x: f"Selected among {x} values"
    )
    # Delete the temporary “Nb” column that is no longer needed
    df_filtered = df_filtered.drop(columns=["Nb"])
    
    df_filtered.to_csv(f"{output_file_matches}", sep="\t", index=False)

def main():
    parser = argparse.ArgumentParser(
        description="Matches peaks from a annotated_file file on a annotated_file file."
    )
    parser.add_argument(
        "--query_file",
        type=Path,
        help="Path to the annotated file (annotated.tsv).",
    )

    parser.add_argument(
        "--profia_file",
        type=Path,
        help="Path to the profia file (features.csv).",
    )

    parser.add_argument(
            "--ppm",
            type=int,
            help="Tolerance in ppm for the m/z matching.",
        )

    parser.add_argument(
        "--precursor_name_col",
        type=int,
        help="Column index for the precursor name.",
    )

    args = parser.parse_args()

    match_table(args.query_file, args.profia_file, args.ppm, args.precursor_name_col)

if __name__ == "__main__":
    main()

