#! /usr/bin/env python3

import argparse
import pandas as pd
from pathlib import Path
import os


def concatenate_files(input_files: Path, output_file:Path):
    """
    Concatenates multiple input files into a single output file.

    :param input_files: Path to the directory containing input files
    :param output_file: Path to the output file where concatenated data will be saved
    """
    input_files = [pd.read_csv(Path(root) / file, sep="\t") 
               for root, _, files in os.walk(input_files) 
               for file in files if file.endswith(".matches.tsv")]
    
    concatenated_df = pd.concat(input_files, ignore_index=True)
    concatenated_df = concatenated_df.sort_values(by="Datetime", ascending=True)
    concatenated_df.to_csv(output_file, sep="\t", index=False)

    
def main():
    parser = argparse.ArgumentParser(
        description="Concatenates multiple files into a single output file."
    )
    parser.add_argument(
        "--input_files",
        type=Path)
    
    parser.add_argument(
        "--output_file",
        type=Path)
    
    args = parser.parse_args()

    concatenate_files(
        args.input_files,
        args.output_file
    )

if __name__ == "__main__":
    main()