#! /usr/bin/env python3

import argparse
import pandas as pd
from pathlib import Path
import os


def concatenate_files(input_files: Path, output_file:Path) -> list:
    """
    Retrieves a list of input files from the specified directory.

    :param input_files: Path to the directory containing input files.
    :return: List of file paths.
    """
    i_files = [pd.read_csv(Path(root) / file, sep="\t") 
               for root, _, files in os.walk(input_files) 
               for file in files if file.endswith(".matches.tsv")]
    # for (root, _, files) in os.walk(input_files) :
    #     for file in files:
    #         if file.endswith(".matches.tsv"):
    #             i_files.append(pd.read_csv(Path(root) / file, sep="\t"))

    concatenated_df = pd.concat(i_files[::-1], ignore_index=True)
    concatenated_df.to_csv(output_file, sep="\t", index=False)

    
def main():
    parser = argparse.ArgumentParser(
        description="Concatenates multiple files into a single output file."
    )
    parser.add_argument(
        "--input_files",
        type=Path)
    
    parser.add_argument(
        "--output_file",
        type=Path)
    
    args = parser.parse_args()

    concatenate_files(
        args.input_files,
        args.output_file
    )

# concatenate_files(
#     input_files=Path('/home/kouakou/cylc-run/bioreactor-workflow/run1/share/cycle/'),
#     output_file=Path('/home/kouakou/cylc-run/bioreactor-workflow/run1/share/cycle/all_features.tsv'))

if __name__ == "__main__":
    main()